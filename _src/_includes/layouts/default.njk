{%- set pageTitle -%}{% if title %}{{ title + site.meta.separator + site.meta.title }}{% else %}{{ site.meta.title or site.meta.title }}{% endif %}{%- endset -%}

{%- from 'components/logo.njk' import logo -%}

<!doctype html>
<html lang="en" class="bg-pri-900 antialiased" x-data="{}" x-cloak>

  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>{{ pageTitle | safe }}</title>
    <meta name="description" content="{{ site.meta.description }}" />
    <meta name="author" content="{{ site.meta.author + ' - '+ site.meta.author_url }}" />
    <meta name="generator" content="{{ eleventy.generator }}" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="{{ '/' | url }}favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link onload="this.onload=null;this.rel='stylesheet'" rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@100..900&display=swap" />

    <meta name="title" content="{{ pageTitle | safe }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ page.url | url }}" />
    <meta property="og:title" content="{{ pageTitle | safe }}" />
    <meta property="og:description" content="{{ site.meta.description }}" />
    <meta property="og:image" content="{{ site.meta.url }}/og-image.png" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="{{ page.url | url }}" />
    <meta property="twitter:title" content="{{ pageTitle | safe }}" />
    <meta property="twitter:description" content="{{ site.meta.description }}" />
    <meta property="twitter:image" content="{{ site.meta.url }}/og-image.png" />

    <link rel="apple-touch-icon" sizes="180x180" href="{{ site.meta.url }}/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="{{ site.meta.url }}/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="{{ site.meta.url }}/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="{{ site.meta.url }}/favicon.ico" />
    <link rel="manifest" href="{{ site.meta.url }}/site.webmanifest" />

  </head>

  <body class="bg-sec-200 bg-opacity-80 text-pri-900 !block" style="display: none;">

    <div class="bg-black/70 fixed{% if page.url === '/' %} inset-0{% else %} h-[300px] inset-x-0 top-0 {% endif %}" aria-hidden="true"></div>
    {%- if page.url == '/' %}<div class="w-1/2 h-screen bg-(right contain no-repeat) fixed top-0 right-0 opacity-10 filter transform translate-x-1/3" aria-hidden="true" style="background-image: url('{{ '/' | url }}_assets/img/bg-hornet.png')"></div>{%- endif %}

    <div class="min-h-screen flex-(& col) relative">
      <header class="py-6 px-4 w-full flex-none relative lg:(py-10)">
        <div class="mx-auto max-w-7xl flex-(& wrap) items-center justify-between lg:(flex-nowrap)">
          <a href="{{ '/' | url }}" class="group block transform motion-safe:(transition) hover:(rotate-3) lg:(flex-none)">
            {{ logo(
              title=site.meta.title,
              svg='m-auto w-auto h-12 text-sec-500 motion-safe:(transition) group-hover:(text-sec-200) lg:(h-16)',
              tag='text-pri-600 motion-safe:(transition) group-hover:(text-pri-300)'
            ) }}
          </a>
          <div class="line-through mb-6 pb-6 border-(b pri-500/30) w-full text-(pri-500 xs) order-first lg:(mb-0 pb-0 border-0 w-auto text-base flex-1 order-none)">
            {% for info in site.reunion.slice(0, 1) %}
              <div class="mx-auto flex items-center justify-center space-x-2 sm:(space-x-4)">
                <p>
                  <time datetime="{{ info.dateFull }}">
                    {{ info.dateMonth }}
                    {{ info.dateDay }},
                    {{ info.dateYear }}
                  </time>
                </p>
                <b class="opacity-30" aria-hidden="true">&mdash;</b>
                <p><sup class="mr-1 inline-block opacity-70">@</sup>{{ info.time }}pm</p>
                <b class="opacity-30" aria-hidden="true">&mdash;</b>
                <p>{{ info.location }}</p>
              </div>
            {% endfor %}
          </div>
          <div class="flex items-center space-x-8 lg:(flex-(none basis-0) justify-end)">
            <a href="{{ '/spirit/' | url }}" class="{{ ui.btn }} btn-secondary">
              <iconify-icon icon="mdi:storefront" class="iconify" noobserver></iconify-icon>
              <span>{{ site.nav.action }} <small class="pt-px text-xs font-semibold block opacity-70">Donate / Merch</small></span>
            </a>
          </div>
        </div>
      </header>
      <main class="w-full h-full flex-1">
        {{ content | safe }}
      </main>
      <footer class="mt-auto w-full flex-none">
        <div class="py-4 px-4 bg-white lg:(pt-24)">
          <div class="-mx-4 py-20 px-4 max-w-4xl bg-(sec-300 gradient-to-r) from-sec-100 relative relative sm:(px-6) md:(mx-auto rounded-3xl px-16)">
            <div class="ring-(2 inset sec-500/20) hidden absolute inset-0 transform translate-x-5 translate-y-5 rotate-2 rounded-3xl lg:(block)" aria-hidden="true"></div>
            <div class="ring-(2 inset sec-500/50) hidden absolute inset-0 transform -translate-x-4 -translate-y-4 -rotate-1 rounded-3xl lg:(block)" aria-hidden="true"></div>
            <div class="mx-auto max-w-2xl grid-(& grid-cols-1) items-center gap-x-16 gap-y-14 relative z-10 xl:(max-w-none grid-cols-2)">
              <div class="text-sec-700 space-y-4">
                <strong class="text-(4xl sec-900) tracking-tighter font-black block sm:(text-5xl)">{{ site.newsletter.heading }}</strong>
                <p class="text-lg tracking-tight">{{ site.newsletter.lead }}</p>
              </div>
              <div class="xl:(text-center)">
                <a href="http://eepurl.com/h8CPAL" class="{{ ui.btn }} btn-primary btn-wide">{{ site.newsletter.action }}</a>
              </div>
            </div>
            <div class="w-1/2 bg-(left no-repeat) absolute inset-y-0 right-0 opacity-30 filter blur-md" style="background-image: url('{{ '/' | url }}_assets/img/bg-hornet.png')"></div>
          </div>
          <section class="mt-12 mx-auto py-12 max-w-7xl text-center lg:(text-start flex justify-between)">
            <div class="mx-auto max-w-sm flex-none space-y-8 lg:(mx-0)">
              <a href="{{ '/' | url }}" class="group inline-flex transform motion-safe:(transition) hover:(rotate-3)">
                {{ logo(
                  title=site.meta.title,
                  svg='m-auto w-auto h-10 text-sec-500 motion-safe:(transition) group-hover:(text-sec-400) lg:(h-16)',
                  tag='hidden',
                  square=true
                ) }}
              </a>
              <p class="text-(gray-500 wrap-balance)">{{ site.meta.description }}</p>
              <ul class="flex-(& wrap) justify-center space-x-8 lg:(justify-start)">
                {%- for soc in site.social %}
                <li><a href="{{ soc.url }}" class="text-(3xl gray-400) inline-flex motion-safe:(transition) hover:(text-pri-700)" aria-label="{{ soc.title }}"><iconify-icon icon="{{ soc.ico }}" inline="false" class="m-auto" noobserver></iconify-icon></a></li>
                {%- endfor %}
              </ul>
            </div>
            <nav class="mx-auto w-full flex-(& col) gap-10 md:(max-w-xl flex-row justify-end gap-32) lg:(mx-0)">
              {%- for nav in site.footer %}
              <div class="mt-12 lg:(mt-0)">
                <strong class="text-(sm gray-600) uppercase">{{ nav.title }}</strong>
                <ul role="list" class="mt-4 space-y-4">
                  {%- for item in nav.nav %}
                  <li>
                    <a href="{{ item.url | url }}" class="group text-pri-700/80 inline-flex flex-col motion-safe:(transition) hover:(text-pri-800)">
                      {{ item.title }}
                      {%- if item.sub %}<small class="text-(xs gray-500/80)">{{ item.sub }}</small>{%- endif %}
                      <b class="h-px w-full flex"><b class="w-0 bg-current motion-safe:(transition-all) group-hover:(w-full)"></b></b>
                    </a>
                  </li>
                  {%- endfor %}
                </ul>
              </div>
              {%- endfor %}
            </nav>
          </section>
          <section class="pt-6 pb-2 border-(t gray-500/20) text-(sm gray-500 center)">
            <div class="mx-auto max-w-7xl flex items-center justify-between">
              <p>&copy;{% year %} {{ site.meta.footer }}</p>
              <small>Updated: <time datetime="{% build 'raw' %}">{% build %}</time></small>
            </div>
          </section>
        </div>
      </footer>
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-0 h-0 text-white fill-current absolute bottom-0 left-0" aria-hidden="true">
      <defs>
        <g id="div-shape" fill-rule="evenodd">
          <polygon points="0 86 25 72 50 86 75 72 100 86 125 72 150 86 175 72 200 86 225 72 250 86 275 72 300 86 325 72 350 86" />
          <polygon opacity=".2" points="225 50 250 36 275 50 275 72 250 86 225 72" />
          <polygon opacity=".4" points="125 50 150 36 175 50 175 72 150 86 125 72" />
          <polygon opacity=".6" points="75 50 100 36 125 50 125 72 100 86 75 72" />
          <polygon opacity=".4" points="25 50 50 36 75 50 75 72 50 86 25 72" />
          <polygon opacity=".2" points="50 14 75 0 100 14 100 36 75 50 50 36" />
        </g>
        <pattern id="div-t" width="350" height="86" patternUnits="userSpaceOnUse">
          <use href="#div-shape" />
        </pattern>
        <pattern id="div-b" width="350" height="86" patternUnits="userSpaceOnUse">
          <use href="#div-shape" transform="scale(1,-1) translate(0,-86)" />
        </pattern>
      </defs>
    </svg>

    <script src="{{ '/' | url }}_assets/js/_app.js?v={% bust %}"></script>

  </body>

</html>
